# ---------------------------------------------------------------------------
# OPTIONAL. The site works without any of this — it falls back to the snapshot
# committed at lib/github.snapshot.json (refreshed by the sync script / the
# scheduled GitHub Action). Set GITHUB_TOKEN to make the live read work.
# ---------------------------------------------------------------------------

# A read-only GitHub token (classic: no scopes needed for public data;
# fine-grained: public read). Pinned items are public, so nothing more is
# required. Without it the site still shows your pins — just from the last
# synced snapshot instead of live.
GITHUB_TOKEN=

# Whose pins to read. Defaults to Emerald-dev0.
GITHUB_LOGIN=Emerald-dev0
