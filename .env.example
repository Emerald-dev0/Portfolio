# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Nothing here is required to run the site
# locally: the blog falls back to a SQLite file and local uploads.
# ---------------------------------------------------------------------------

# The one admin password. Without it, /admin sign in is disabled.
STUDIO_PASSWORD=

# Database. Leave both blank to use ./.data/cms.db in development.
# In production, create a Turso database and paste the two values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Salt for the daily visitor hash. Any long random string. Rotating it resets
# unique reader counts, which is a feature, not a bug.
ANALYTICS_SALT=

# Shared secret for the scheduled publish cron. Vercel sends it as
# "Authorization: Bearer <value>".
CRON_SECRET=

# Vercel Blob, for the media library. Without it, uploads go to public/uploads
# and work locally only.
BLOB_READ_WRITE_TOKEN=

# Now playing widget
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional
GITHUB_TOKEN=
